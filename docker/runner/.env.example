# Copy to docker/runner/.env on the server and fill in. Never commit .env.

# GitHub PAT the runner container uses to mint its own registration token on
# every start/restart. Fine-grained, scoped to EpicNicks/Qamooscheh-Web,
# "Administration: Read and write" permission. You can reuse Qamooscheh's own
# runner PAT here (edit its repository access list to add Qamooscheh-Web)
# instead of creating a second one, if you'd rather manage one token.
GH_RUNNER_PAT=

# Same host as Qamooscheh's own runner -- same value applies:
# getent group docker | cut -d: -f3, or (per that repo) stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# Absolute path to THIS repo's real .env.docker (the compose build args --
# VITE_API_BASE_URL etc.), bind-mounted into the runner container at this
# same path so `docker compose --env-file "$ENV_FILE"` resolves identically
# whether it runs on the host or inside this container. Must match ENV_FILE
# in .github/workflows/deploy.yml exactly.
# e.g. /home/<you>/qamooscheh/qamooscheh-web/.env.docker
APP_ENV_FILE=

# Absolute path, on the host, where this runner's own job checkouts live --
# MUST be different from Qamooscheh's own RUNNER_WORK_HOST_DIR (two separate
# runner containers, two separate work trees). Create with `mkdir -p` first,
# same as ARTIFACTS_DIR/Qamooscheh's own RUNNER_WORK_HOST_DIR.
# e.g. /home/<you>/qamooscheh/runner-work-web
RUNNER_WORK_HOST_DIR=
