# Copy to .env.docker and fill in, then `docker compose --env-file .env.docker up -d --build`.
# Never commit .env.docker.
#
# Separate from .env.example/.env.local on purpose — those are read by Vite's
# dev server (npm run dev) at runtime from your machine; these are read by
# docker-compose itself, at BUILD time, to bake VITE_* into the production
# bundle (Vite has no runtime config step — see the Dockerfile's own comment).

# The backend's public origin — matches Qamooscheh's own .env's CONTENT_BASE_URL
# domain convention (api.<domain>). No trailing path.
VITE_API_BASE_URL=https://api.qamooscheh.example

# The artifacts CDN's public origin (Qamooscheh's `edge` nginx container,
# proxied by your host nginx as cdn.<domain>). No /artifacts suffix — see
# nginx.conf/README, this mirrors docker/nginx/artifacts.conf's own URL shape.
VITE_CONTENT_BASE_URL=https://cdn.qamooscheh.example

# Same Google OAuth client id the backend's Auth__GoogleClientId is set to.
# Leave blank to ship without Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Host-side port, bound to 127.0.0.1 only — your host nginx is the public
# entry point (app.<domain> -> this). Change if it collides with something
# else on the box; the backend's own compose.yaml already uses 8080/8081.
WEB_PORT=8082
