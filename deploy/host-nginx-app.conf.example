# Reference vhost for the host-level nginx that terminates TLS and is the
# server's sole public entry point (same model Qamooscheh's own compose.yaml
# describes: every container binds 127.0.0.1 only). Adapt and drop into
# your host nginx's sites-enabled/conf.d — this file isn't loaded by
# anything itself.
#
# Qamooscheh's own README references an equivalent deploy/host-nginx.conf
# for api.<domain>/cdn.<domain>/dash.<domain> in that repo; as of this
# writing that file doesn't actually exist there, so you'll need to write
# those vhosts yourself too — this one is written to sit alongside them,
# proxying to WEB_PORT (.env.docker) the same way those would proxy to
# API_PORT/ARTIFACTS_PORT/DASHBOARD_PORT.

server {
    listen 443 ssl http2;
    server_name app.qamooscheh.example;

    # ssl_certificate / ssl_certificate_key -- e.g. certbot-managed, same as
    # whatever the backend's vhosts use.

    location / {
        proxy_pass http://127.0.0.1:8082;   # WEB_PORT
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name app.qamooscheh.example;
    return 301 https://$host$request_uri;
}
