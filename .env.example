# Copy to .env.local for local dev (Vite reads .env.local automatically, and
# it's already git-ignored).

# Qamooscheh.Api — matches Properties/launchSettings.json's dev "http" profile.
VITE_API_BASE_URL=http://localhost:5239

# Root of wherever the backend's `artifacts/` folder (course + grader
# artifacts) is being served as static files in dev. Api never serves these
# (API_SPEC.md §1) — point this at a plain static file server rooted at that
# folder, e.g. `npx serve ../Qamooscheh/artifacts` and set this to its origin
# with `/artifacts` appended.
VITE_CONTENT_BASE_URL=http://localhost:8080/artifacts

# Google Identity Services client id — must match the backend's
# Auth:GoogleClientId. Leave blank to disable Google sign-in.
VITE_GOOGLE_CLIENT_ID=
